# 可选：正式部署建议配置自己的 OpenAlex key。
OPENALEX_API_KEY=
# 可选：填写自己的邮箱，加入 Crossref polite pool。
CROSSREF_MAILTO=

# 第二阶段：OpenAI-compatible Chat Completions API
# BASE_URL 应为 API 根路径，不包含 /chat/completions。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 填写服务商实际提供且支持 Chat Completions 的模型 ID。
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_JSON_MODE=true
# 部分兼容服务使用 max_tokens；OpenAI 新模型一般使用 max_completion_tokens。
LLM_TOKEN_PARAMETER=max_tokens
